#!/bin/bash
set -e

echo "[+] ===== NVIDIA BUILD (OFFICIAL INSTALL + CAPTURE + XORG) ====="

cd /root/nvidia
chmod +x *.run
KERNEL=$(uname -r)

# 1. Estrutura de armazenamento
mkdir -p /opt/nvidia/{open,legacy}/system_root

# Parâmetros originais validados para as versões 580 e 595
COMMON_FLAGS="--silent --no-questions --no-dkms --no-nouveau-check --no-disable-nouveau --no-systemd --no-install-compat32-libs --no-rebuild-initramfs --skip-module-load --no-opengl-files"

RUN_NEW=$(ls NVIDIA-Linux-x86_64-595*.run | head -n1)
RUN_OLD=$(ls NVIDIA-Linux-x86_64-580*.run | head -n1)

capture_install() {
    local TYPE=$1
    local RUN_FILE=$2
    local MOD_TYPE=$3
    local TARGET="/opt/nvidia/$TYPE/system_root"

    echo "[+] Rodando instalador oficial para $TYPE..."
    ./"$RUN_FILE" $COMMON_FLAGS --kernel-module-type="$MOD_TYPE"

    # 2. Criar estrutura no destino espelhando os caminhos exatos
    mkdir -p "$TARGET/usr/bin"
    mkdir -p "$TARGET/usr/lib/x86_64-linux-gnu"
    mkdir -p "$TARGET/lib/modules/$KERNEL/kernel/drivers/video"
    mkdir -p "$TARGET/lib/firmware/nvidia"
    mkdir -p "$TARGET/usr/lib/xorg/modules/drivers"
    mkdir -p "$TARGET/usr/lib/xorg/modules/extensions"

    echo "[+] Capturando arquivos para $TARGET..."
    
    # A. Binários
    mv /usr/bin/nvidia* "$TARGET/usr/bin/" 2>/dev/null || true
    
    # B. Bibliotecas (CUDA, NVML, Video Decoding)
    mv /usr/lib/x86_64-linux-gnu/libnvidia* "$TARGET/usr/lib/x86_64-linux-gnu/" 2>/dev/null || true
    mv /usr/lib/x86_64-linux-gnu/libcuda* "$TARGET/usr/lib/x86_64-linux-gnu/" 2>/dev/null || true
    mv /usr/lib/x86_64-linux-gnu/libnvcuvid* "$TARGET/usr/lib/x86_64-linux-gnu/" 2>/dev/null || true
    
    # C. Módulos do Kernel
    mv /lib/modules/$KERNEL/kernel/drivers/video/nvidia* "$TARGET/lib/modules/$KERNEL/kernel/drivers/video/" 2>/dev/null || true
    
    # D. Firmware (GSP)
    if [ -d /lib/firmware/nvidia ]; then
        mv /lib/firmware/nvidia/* "$TARGET/lib/firmware/nvidia/" 2>/dev/null || true
    fi

    # E. Módulos do Servidor Gráfico (Xorg)
    mv /usr/lib/xorg/modules/drivers/nvidia* "$TARGET/usr/lib/xorg/modules/drivers/" 2>/dev/null || true
    mv /usr/lib/xorg/modules/extensions/libglxserver_nvidia* "$TARGET/usr/lib/xorg/modules/extensions/" 2>/dev/null || true

    # 3. Limpar rastros antes de rodar a próxima versão
    rm -f /usr/bin/nvidia* /usr/lib/x86_64-linux-gnu/libnvidia* /usr/lib/x86_64-linux-gnu/libcuda* || true
    rm -f /usr/lib/xorg/modules/drivers/nvidia* /usr/lib/xorg/modules/extensions/libglxserver_nvidia* || true
}

# 4. Execução das capturas
capture_install "legacy" "$RUN_OLD" "proprietary"
capture_install "open" "$RUN_NEW" "open"

# 5. Finalização
systemctl enable nvidia-select.service
rm -rf /root/nvidia/*.run

echo "[+] ===== FINALIZADO ====="