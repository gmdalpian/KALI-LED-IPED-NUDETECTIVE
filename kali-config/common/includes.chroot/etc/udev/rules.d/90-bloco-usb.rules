# Udev Rule for Global Disk Write-Protection (Hotplug)
# 
# Triggered for ANY block device added to the system after boot
# (physical disk, partition, LVM volume, or LDM mapping), applying 
# read-only mode. Ignores only optical media (sr*).

SUBSYSTEM=="block", ACTION=="add", KERNEL!="sr*", \
RUN+="/sbin/blockdev --setro /dev/%k"